# ---------------------------------------------------------------------------
# Azahar citra_room configuration. Copy this file to `.env` and edit.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Displayed room name. REQUIRED (the binary refuses to start if empty).
ROOM_NAME=My Azahar Room

# Short description shown to clients. Optional.
ROOM_DESCRIPTION=Private 3DS local-play relay

# Preferred application / game name. REQUIRED (the binary refuses to start
# if empty). Free text, e.g. the game title you mostly host.
PREFERRED_APP=Homebrew

# Preferred application / title ID in hex (16 hex digits), optional but
# recommended so clients can match the room to a specific game.
# Example (Mario Kart 7 EUR): 0004000000030700
PREFERRED_APP_ID=

# UDP port the room listens on. Default 24872 (Network::DefaultRoomPort).
ROOM_PORT=24872

# Maximum number of players. Range 2-254 (MaxConcurrentConnections=254).
MAX_MEMBERS=16

# Room password. Optional - leave empty for an open (but unlisted) room.
ROOM_PASSWORD=

# Advanced (usually leave as-is; paths are inside the room-data volume):
# LOG_FILE=/data/citra-room.log
# BAN_LIST_FILE=/data/ban-list.txt
